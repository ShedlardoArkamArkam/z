-- Anti-AFK. Prefer executor connection controls; use VirtualUser as a fallback.
-- Connections disabled with :Disable() are restored when STOP is pressed.
local DisabledIdleConnections = {}
local function SetupAntiAFK()
    if not ANTI_AFK_ENABLED then
        return
    end
    local GC = getconnections or get_signal_cons
    if type(GC) == "function" then
        local ok, idleConnections = pcall(GC, Player.Idled)
        if ok and type(idleConnections) == "table" then
            for _, connection in pairs(idleConnections) do
                pcall(function()
                    if type(connection.Disable) == "function" then
                        local wasEnabled
                        pcall(function()
                            wasEnabled = connection.Enabled
                        end)
                        -- Leave connections that were already disabled alone.
                        if wasEnabled ~= false then
                            connection:Disable()
                            table.insert(DisabledIdleConnections, {
                                connection = connection,
                                wasEnabled = wasEnabled,
                            })
                        end
                    elseif type(connection.Disconnect) == "function" then
                        -- Some executor connection wrappers only expose Disconnect.
                        connection:Disconnect()
                    end
                end)
            end
            return
        end
    end
    -- Fallback for environments without getconnections/get_signal_cons.
    local VirtualUser = game:GetService("VirtualUser")
    local fallbackConnection = Player.Idled:Connect(function()
        if not Running or not ANTI_AFK_ENABLED then
            return
        end
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end)
    table.insert(Connections, fallbackConnection)
end
