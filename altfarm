    local elapsed = math.max(os.clock() - sessionStartTime, 1)
    local killsPerHour = sessionKills * 3600 / elapsed
    local totalKills = tonumber(TotalKillsStat.Value) or 0
    local currentKills = tonumber(CurrentKillsStat.Value) or 0

    nextMilestone = (math.floor(math.max(0, totalKills) / 5000) + 1) * 5000
