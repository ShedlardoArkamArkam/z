-- STOP everything; destroying the GUI clears the stats and mode buttons too.
local function Stop()
    if not Running then
        return
    end
    Running = false
    pcall(function()
        ExecutorEnvironment[ACTIVE_SCRIPT_FLAG] = nil
    end)
    CancelMainWebhookSchedule()

    -- STOP really stops the script: no persistence queue or auto-rejoin after this point.
    KeepScriptEnabled = false
    StoreExecutorFlag(KEEP_SCRIPT_FLAG, false)
    DisableAutoRejoin()
    if PersistenceTeleportConnection then
        pcall(function()
            PersistenceTeleportConnection:Disconnect()
        end)
        PersistenceTeleportConnection = nil
    end

    TargetTeleporting = false
    TargetLockedForSkill = nil
    TargetEngaged = false
    DisconnectAltDamageMonitor()
    StopAltAnimation()
    RestoreAltAutoRotate()
    pcall(function()
        RunService:UnbindFromRenderStep(AltSpinBindingName)
    end)
    if MouseHeld then
        Mouse(false)
    end
    for keyCode in pairs(HeldKeys) do
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
        end)
        HeldKeys[keyCode] = nil
    end
    for _, connection in ipairs(Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    -- Restore Idled connections that were disabled by this script, when supported.
    for _, entry in ipairs(DisabledIdleConnections) do
        if entry.wasEnabled ~= false then
            pcall(function()
                if type(entry.connection.Enable) == "function" then
                    entry.connection:Enable()
                end
            end)
        end
    end
    table.clear(DisabledIdleConnections)
    Gui:Destroy()
end
