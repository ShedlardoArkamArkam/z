local function StopAltAnimation()
    local track = AltAnimationTrack
    local animationObject = AltAnimationObject
    AltAnimationTrack = nil
    AltAnimationObject = nil
    AltAnimationCharacter = nil
    if track then
        pcall(function()
            track:Stop(0)
