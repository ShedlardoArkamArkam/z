-- Find the oldest-spawned target who is alive now and has been alive for at least TARGET_ALIVE_SECONDS seconds.
local function GetOldestAliveTarget()
    local candidates = {}
    local now = os.clock()
    for _, username in ipairs(TargetNames) do
        local targetPlayer = Players:FindFirstChild(username)
        if targetPlayer then
            TrackTarget(targetPlayer)
            local character = targetPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local aliveSince = AliveSince[targetPlayer]
            -- If health is positive but tracking just started, start the alive timer now.
            if character and humanoid and humanoid.Health > 0 and not aliveSince then
                aliveSince = now
                AliveSince[targetPlayer] = aliveSince
            end
            if character and humanoid and humanoid.Health > 0
                and root and root:IsA("BasePart")
                and aliveSince and (now - aliveSince) >= TARGET_ALIVE_SECONDS then
                table.insert(candidates, {
                    player = targetPlayer,
                    character = character,
                    humanoid = humanoid,
                    root = root,
                    spawnTime = SpawnTimes[targetPlayer] or StartupTime,
                    aliveSince = aliveSince
                })
            end
        end
    end
    if #candidates == 0 then
        return nil
    end
    -- Earlier character spawn time wins; ties preserve TargetNames order.
    local chosen = candidates[1]
    for i = 2, #candidates do
        if candidates[i].spawnTime < chosen.spawnTime then
            chosen = candidates[i]
        end
    end
    return chosen
end
-- Teleport the local character's HumanoidRootPart to an exact staging position while preserving rotation.
local function TeleportLocalToStaging()
    if not Running then
        return false
    end
    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or humanoid.Health <= 0
        or not root or not root:IsA("BasePart") then
        return false
    end
    -- Alt mode places each character only once per life. Once placed, do not
    -- re-check nearby players or move this character if someone approaches.
    if Mode == "Alt" and AltStageTeleportedCharacter == character then
        return true
    end
    -- Choose and cache the position for this character. If no safe location
    -- can be found initially, later attempts may retry until one is available.
    local stagingPosition = GetStagingPositionForCharacter(character)
    if not stagingPosition then
        return false
    end
    -- Preserve the existing dynamic re-check behavior for Main mode only.
    -- Alt mode intentionally keeps its first safe position for the whole life.
    if USE_VOID_STAGE and Mode == "Main" then
        local otherRoots = GetOtherLivingPlayerRoots()
        if not IsSafeVoidPosition(
            stagingPosition,
            otherRoots,
            VOID_STAGE_MIN_PLAYER_DISTANCE
        ) then
            stagingPosition = ChooseSafeVoidPosition()
            CurrentStagingPosition = stagingPosition
            StagingPositionCharacter = character
            -- In a crowded server, retry later rather than teleporting to a
            -- position that failed the minimum-distance check.
            if not stagingPosition then
                return false
            end
        end
    end
    local rootRotation = root.CFrame - root.Position
    local desiredRootCFrame = CFrame.new(stagingPosition) * rootRotation
    local pivotOffset = root.CFrame:ToObjectSpace(character:GetPivot())
    local success = pcall(function()
        character:PivotTo(desiredRootCFrame * pivotOffset)
    end)
    if success and Mode == "Alt" then
        AltStageTeleportedCharacter = character
    end
    return success
end
-- Teleport behind a selected target, one stud back, matching target root rotation.
local function TeleportBehindTarget(chosen)
    if not Running or Mode ~= "Main" then
        return false
    end
    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or humanoid.Health <= 0
        or not root or not root:IsA("BasePart") then
        return false
    end
    local myY = root.Position.Y
    local deepVoidOverride = myY < TARGET_TELEPORT_DEEP_VOID_OVERRIDE_Y
    -- Pause while between Y=-500 and Y=-550, then allow target-following to
    -- resume below Y=-550, even if the regular void/death phase is active.
    if myY < TARGET_TELEPORT_BLOCK_Y and not deepVoidOverride then
        return false
    end
    if not deepVoidOverride and (not TargetTeleporting or InVoidPhase) then
        return false
    end
    if deepVoidOverride then
        TargetTeleporting = true
    end
    if not chosen then
        chosen = TargetLockedForSkill
    end
    if not chosen
        or chosen.player.Character ~= chosen.character
        or chosen.humanoid.Health <= 0
        or not chosen.root.Parent then
        return false
    end
    local aliveSince = AliveSince[chosen.player]
    if not aliveSince or (os.clock() - aliveSince) < TARGET_ALIVE_SECONDS then
        return false
    end
    -- Local +Z is behind the target's facing direction.
    local desiredRootCFrame = chosen.root.CFrame * CFrame.new(0, 0, 1)
    local pivotOffset = root.CFrame:ToObjectSpace(character:GetPivot())
    local success = pcall(function()
        character:PivotTo(desiredRootCFrame * pivotOffset)
    end)
    TargetEngaged = success
    return success
end
-- Lock one eligible target for this skill attempt. The background loop keeps
-- following this same target after the key press until it dies/despawns; a
-- different target can only be selected at the next skill attempt.
local function TeleportThenTapKey(keyCode)
    if not Running or Mode ~= "Main" then
        return false
    end
    TargetTeleporting = false
    TargetLockedForSkill = nil
    TargetEngaged = false
    while Running and Mode == "Main" and not InVoidPhase do
        local chosen = GetOldestAliveTarget()
        if chosen then
            TargetLockedForSkill = chosen
            TargetTeleporting = true
            TargetEngaged = true
            if TeleportBehindTarget(chosen) then
                if not WaitForMain(0.2) then
                    TargetTeleporting = false
                    TargetLockedForSkill = nil
                    return false
                end
                -- Do not reselect a different target here. Keep the same target
                -- locked during the pre-skill wait. If it has moved/died, the
                -- final teleport will simply fail and the scheduled key still fires.
                if chosen.player.Character == chosen.character
                    and chosen.humanoid.Parent
                    and chosen.humanoid.Health > 0
                    and chosen.root.Parent
                    and AliveSince[chosen.player]
                    and (os.clock() - AliveSince[chosen.player]) >= TARGET_ALIVE_SECONDS then
                    TeleportBehindTarget(chosen)
                end
                return TapKey(keyCode)
            else
                TargetTeleporting = false
                TargetLockedForSkill = nil
                TargetEngaged = false
            end
        else
            TargetTeleporting = false
            TargetLockedForSkill = nil
            TargetEngaged = false
        end
        if not WaitForMain(0.05) then
            TargetTeleporting = false
            TargetLockedForSkill = nil
            return false
        end
    end
    TargetTeleporting = false
    TargetLockedForSkill = nil
    return false
end
