local function ResolveQueueOnTeleport()
    local queueFunction

    pcall(function()
        if type(syn) == "table" and type(syn.queue_on_teleport) == "function" then
            queueFunction = syn.queue_on_teleport
        end
    end)
    if type(queueFunction) ~= "function" and type(queue_on_teleport) == "function" then
        queueFunction = queue_on_teleport
    end
    if type(queueFunction) ~= "function" and type(queueteleport) == "function" then
        queueFunction = queueteleport
    end
