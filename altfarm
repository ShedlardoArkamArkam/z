-- Generation token used to invalidate old Main-mode webhook loops safely.
local webhookScheduleGeneration = 0

local function GetWebhookSessionTime()
    local elapsedSeconds = math.max(0, math.floor(os.clock() - sessionStartTime))
    local days = math.floor(elapsedSeconds / 86400)
    local hours = math.floor((elapsedSeconds % 86400) / 3600)
    local minutes = math.floor((elapsedSeconds % 3600) / 60)
    local seconds = elapsedSeconds % 60
    return string.format("%dd %02dh %02dm %02ds", days, hours, minutes, seconds)
end

local function GetKillsNeededForWebhook()
    if RankPromotionKillsNeeded == nil then
