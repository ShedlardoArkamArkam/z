        pcall(function()
            connection:Disconnect()
        end)
    end
    -- Restore Idled connections that were disabled by this script, when supported.
    for _, entry in ipairs(DisabledIdleConnections) do
        if entry.wasEnabled ~= false then
            pcall(function()
                if type(entry.connection.Enable) == "function" then
                    entry.connection:Enable()
                end
            end)
        end
    end
    table.clear(DisabledIdleConnections)
    Gui:Destroy()
end
