-- Track how long each target character has been alive.
local function TrackTargetCharacter(targetPlayer, character, isInitialCharacter)
    if not isInitialCharacter then
        SpawnTimes[targetPlayer] = os.clock()
    elseif not SpawnTimes[targetPlayer] then
        SpawnTimes[targetPlayer] = StartupTime
    end
    AliveSince[targetPlayer] = nil
    TargetEngaged = false
    task.spawn(function()
        local humanoid = character:FindFirstChildOfClass("Humanoid")
            or character:WaitForChild("Humanoid", 10)
        if not Running or not humanoid or targetPlayer.Character ~= character then
            return
        end
        if humanoid.Health > 0 then
            AliveSince[targetPlayer] = os.clock()
        end
        local healthConnection = humanoid.HealthChanged:Connect(function(health)
            if targetPlayer.Character ~= character then
                return
            end
            if health > 0 then
                if not AliveSince[targetPlayer] then
                    AliveSince[targetPlayer] = os.clock()
                end
            else
                AliveSince[targetPlayer] = nil
                TargetEngaged = false
            end
        end)
        table.insert(Connections, healthConnection)
    end)
end
local function TrackTarget(targetPlayer)
    if TrackedTargets[targetPlayer] or not table.find(TargetNames, targetPlayer.Name) then
        return
    end
    TrackedTargets[targetPlayer] = true
    table.insert(Connections, targetPlayer.CharacterAdded:Connect(function(character)
        TrackTargetCharacter(targetPlayer, character, false)
    end))
    if targetPlayer.Character then
        TrackTargetCharacter(targetPlayer, targetPlayer.Character, true)
    end
end
for _, targetPlayer in ipairs(Players:GetPlayers()) do
    TrackTarget(targetPlayer)
end
