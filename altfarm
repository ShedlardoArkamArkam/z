-- If the compact launcher is executed again, detect changed global settings and
-- apply them live without starting a duplicate copy of the main script.
local function TargetListsMatch(a, b)
    if type(a) ~= "table" or #a ~= #b then
        return false
    end
    for index, name in ipairs(b) do
        if a[index] ~= name then
            return false
        end
    end
    return true
end

