-- Send standalone status notices, independent of the selected farming mode.
local function SendAutoRejoinWebhookNotice(status, details, attemptNumber)
    if type(WEBHOOK_URL) ~= "string" or WEBHOOK_URL == "" then
        return
    end

    local requestFunction = nil
    if type(request) == "function" then
        requestFunction = request
    elseif type(http_request) == "function" then
        requestFunction = http_request
    else
        pcall(function()
            if type(syn) == "table" and type(syn.request) == "function" then
                requestFunction = syn.request
            end
        end)
    end
    if type(requestFunction) ~= "function" then
        warn("Auto Rejoin webhook not sent: no supported HTTP request function.")
        return
    end

    local payload = {
        username = "Farm Monitor",
        embeds = {{
            title = "Alt Farm update",
            description = "**Auto Rejoin: " .. tostring(status) .. "**\n" .. tostring(details or ""),
            color = status == "Kick detected" and 0xDC2626 or 0x8B5CF6,
            fields = {
                {
                    name = "👤 User",
                    value = tostring(Player.DisplayName) .. " (`" .. tostring(Player.Name) .. "`)",
                    inline = true,
                },
                {
                    name = "Mode",
                    value = tostring(Mode),
                    inline = true,
                },
                {
                    name = "Attempt",
                    value = tostring(attemptNumber or 0),
                    inline = true,
                },
            },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        }},
    }

    local okEncode, body = pcall(function()
        return HttpService:JSONEncode(payload)
    end)
    if not okEncode then
        warn("Auto Rejoin webhook not sent: failed to encode payload: " .. tostring(body))
        return
    end

    task.spawn(function()
        local okRequest, response = pcall(function()
            return requestFunction({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body,
            })
        end)
        if not okRequest then
            warn("Auto Rejoin webhook request failed: " .. tostring(response))
            return
        end
        local statusCode = response and (response.StatusCode or response.Status)
        if statusCode and tonumber(statusCode) and tonumber(statusCode) >= 400 then
            warn("Auto Rejoin webhook returned HTTP status " .. tostring(statusCode))
        end
    end)
end

