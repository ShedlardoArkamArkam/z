local function BuildOtherPlayersFields()
    local excluded = {[string.lower(Player.Name)] = true}
    for _, targetName in ipairs(TargetNames) do
        if type(targetName) == "string" and targetName ~= "" then
            excluded[string.lower(targetName)] = true
        end
    end

    local playerLines = {}
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if not excluded[string.lower(otherPlayer.Name)] then
            local totalKills = GetPlayerTotalKills(otherPlayer)
            local killsText = totalKills and FormatWebhookNumber(totalKills) or "N/A"
            table.insert(playerLines, string.format("• %s — %s total kills", otherPlayer.Name, killsText))
        end
    end
    table.sort(playerLines, function(a, b)
        return string.lower(a) < string.lower(b)
    end)

    local fields = {}
    if #playerLines == 0 then
        table.insert(fields, {
            name = "👥  Other players in server",
            value = "No eligible players in the server.",
            inline = false,
        })
        return fields
    end

    -- Discord limits each field value to 1024 characters. Split the list without
    -- dropping anyone, using as many fields as the embed field limit permits.
    local chunk = ""
    local part = 1
    for _, line in ipairs(playerLines) do
        local append = (chunk == "" and line or "\n" .. line)
        if #chunk + #append > 1000 then
            table.insert(fields, {
                name = part == 1 and "👥  Other players in server" or ("Other players (continued " .. part .. ")"),
                value = chunk,
                inline = false,
            })
            part += 1
            chunk = line
        else
            chunk ..= append
        end
    end
    if chunk ~= "" then
        table.insert(fields, {
            name = part == 1 and "👥  Other players in server" or ("Other players (continued " .. part .. ")"),
            value = chunk,
            inline = false,
        })
    end
    return fields
end

local function SendMainWebhookUpdate()
    if not Running or Mode ~= "Main" then
        return
    end

    -- Refresh the target calculation before constructing the report.
    UpdateETAs()
    local elapsed = math.max(os.clock() - sessionStartTime, 1)
    local killsPerHour = sessionKills * 3600 / elapsed
    local totalKills = tonumber(TotalKillsStat.Value) or 0
    local currentKills = tonumber(CurrentKillsStat.Value) or 0
    local rankValue = GetKillsNeededForWebhook()

    local fields = {
        {
            name = "👤  User",
            value = tostring(Player.DisplayName),
            inline = true,
        },
        {
            name = "📊  Total Kills",
            value = "**" .. FormatWebhookNumber(totalKills) .. "**",
            inline = true,
        },
        {
            name = "⚔️  Current Kills",
            value = "**" .. FormatWebhookNumber(currentKills) .. "**",
            inline = true,
        },
        {
            name = "💀  Session kills gained",
            value = "**" .. FormatWebhookNumber(sessionKills) .. "**",
            inline = true,
        },
        {
            name = "⏱️  Session time",
            value = "`" .. GetWebhookSessionTime() .. "`",
            inline = true,
        },
        {
            name = "⚡  Average kills per hour",
            value = "**" .. FormatWebhookNumber(killsPerHour) .. "**",
            inline = true,
        },
        {
            name = "🎯  ETA to next 5k mark (" .. FormatWebhookNumber(nextMilestone or 0) .. ")",
            value = "`" .. tostring(nextMilestoneETA) .. "`",
            inline = true,
        },
        {
            name = "🏆  ETA to Top " .. tostring(nextLeaderboardRank or 15),
            value = "`" .. tostring(nextLeaderboardETA) .. "`",
            inline = true,
        },
    }

    -- Only include the promotion-rank field when its value was actually available.
    if rankValue ~= nil then
        table.insert(fields, 4, {
            name = "🏅  Kills needed for rank",
            value = "**" .. rankValue .. "**",
            inline = true,
        })
    end

    for _, playerField in ipairs(BuildOtherPlayersFields()) do
        if #fields >= 25 then
            warn("Webhook player list clipped by Discord's 25-field embed limit.")
            break
        end
        table.insert(fields, playerField)
    end

    local payload = {
        username = "Farm Monitor",
        embeds = {{
            title = "Alt Farm update",
            color = 0x8B5CF6,
            fields = fields,
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        }},
    }
    -- Executor-provided HTTP request functions vary by environment.
    local requestFunction = nil
    if type(request) == "function" then
        requestFunction = request
    elseif type(http_request) == "function" then
        requestFunction = http_request
    else
        pcall(function()
            if type(syn) == "table" and type(syn.request) == "function" then
                requestFunction = syn.request
            end
        end)
    end
    if type(requestFunction) ~= "function" then
        warn("Webhook not sent: this environment does not expose request/http_request/syn.request.")
        return
    end
    local okEncode, body = pcall(function()
        return HttpService:JSONEncode(payload)
    end)
    if not okEncode then
        warn("Webhook not sent: failed to encode payload: " .. tostring(body))
        return
    end
    task.spawn(function()
        -- Do not send if the user switched away from Main before the request starts.
        if not Running or Mode ~= "Main" then
            return
        end
        local success, response = pcall(function()
            return requestFunction({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body,
            })
        end)
        if success then
            local statusCode = response and (response.StatusCode or response.Status)
            print("Webhook sent. Response code: " .. tostring(statusCode or "unknown"))
        else
            warn("Webhook request failed: " .. tostring(response))
        end
    end)
end
