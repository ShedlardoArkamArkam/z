-- Count kills gained after startup from Total Kills; use that rate for both ETAs.
local sessionStartTime = os.clock()
local lastObservedTotal = tonumber(TotalKillsStat.Value) or 0
local sessionKills = 0
local UpdateETAs

local function UpdateSessionTimer()
    if not Running then
        return
    end
    local elapsedSeconds = math.max(0, math.floor(os.clock() - sessionStartTime))
    local days = math.floor(elapsedSeconds / 86400)
    local hours = math.floor((elapsedSeconds % 86400) / 3600)
    local minutes = math.floor((elapsedSeconds % 3600) / 60)
    local seconds = elapsedSeconds % 60
    SessionTimerLabel.Text = string.format(
        "Session time: %dd %02dh %02dm %02ds",
        days,
        hours,
        minutes,
        seconds
    )
end

local function UpdateSessionKillsAndRate()
    if not Running then
        return
    end
    local currentTotal = tonumber(TotalKillsStat.Value) or lastObservedTotal
    if currentTotal > lastObservedTotal then
        sessionKills += currentTotal - lastObservedTotal
        lastObservedTotal = currentTotal
    elseif currentTotal < lastObservedTotal then
        lastObservedTotal = currentTotal
    end
    local elapsed = math.max(os.clock() - sessionStartTime, 1)
    local killsPerMinute = sessionKills * 60 / elapsed
    local killsPerHour = sessionKills * 3600 / elapsed
    SessionKillsLabel.Text = string.format("Session kills: %d", sessionKills)
    KillsRateLabel.Text = string.format(
        "Kills/min: %.1f  |  Kills/hour: %.0f",
        killsPerMinute,
        killsPerHour
    )
    UpdateSessionTimer()
    if UpdateETAs then
        UpdateETAs()
    end
end

local function FormatWebhookNumber(value)
    local number = math.floor(tonumber(value) or 0)
    local text = tostring(math.abs(number))
    local reversed = text:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    return (number < 0 and "-" or "") .. reversed
end

-- ETA durations are rounded up to the next whole minute, so a positive remainder
-- never appears to be complete early. Example: 3d 9h 30m.
local function FormatETA(killsNeeded, killsPerHour)
    killsNeeded = math.max(0, tonumber(killsNeeded) or 0)
    killsPerHour = tonumber(killsPerHour) or 0
    if killsNeeded <= 0 then
        return "0d 0h 0m"
    end
    if killsPerHour <= 0 then
        return "Calculating..."
    end
    local totalMinutes = math.ceil((killsNeeded / killsPerHour) * 60)
    local days = math.floor(totalMinutes / 1440)
    local hours = math.floor((totalMinutes % 1440) / 60)
    local minutes = totalMinutes % 60
    return string.format("%dd %dh %dm", days, hours, minutes)
end

local function GetLeaderboardKillValues()
    -- Updated game model: Workspace.Map["Total Kills Leaderboard"].Top
    -- is a JSON array whose entries use { u = userId, k = kills, n = username }.
    -- Read the k field directly instead of scraping RichText UI labels.
    local values = {}
    local encodedTop = LeaderboardModel:GetAttribute("Top")

    if type(encodedTop) ~= "string" or encodedTop == "" then
        return values
    end

    local decodeOK, entries = pcall(function()
        return HttpService:JSONDecode(encodedTop)
    end)

    if not decodeOK or type(entries) ~= "table" then
        return values
    end

    for _, entry in ipairs(entries) do
        if type(entry) == "table" then
            local kills = tonumber(entry.k)
            if kills and kills >= 0 then
                table.insert(values, math.floor(kills))
            end
        end
    end

    -- Normalize order rather than depending on the attribute array's order.
    table.sort(values, function(a, b)
        return a > b
    end)

    return values
end

-- Determine the next rank target from the current Kills stat (not Total Kills).
-- If we're at or above the #15 cutoff, move on to #14, then #13, and so on.
local function GetNextLeaderboardTarget(currentKills)
    local values = GetLeaderboardKillValues()
    if #values < 15 then
        return nil, nil, nil, "Waiting for leaderboard"
    end

    -- Need one more kill than a cutoff to be above it. Equality still targets
    -- that rank; only a strictly greater Kills value advances to the next rank.
    for rank = 15, 1, -1 do
        local cutoff = values[rank]
        if currentKills <= cutoff then
            local killsNeeded = math.max(0, cutoff + 1 - currentKills)
            return rank, cutoff, killsNeeded, nil
        end
    end

    -- The current Kills stat is strictly above the displayed Top 1 cutoff.
    return 1, values[1], 0, "Reached"
end

