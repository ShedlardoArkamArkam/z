    MilestoneETALabel.Text = "ETA to " .. FormatWebhookNumber(nextMilestone)
        .. " total kills: " .. nextMilestoneETA

    local targetRank, cutoff, killsNeeded, status = GetNextLeaderboardTarget(currentKills)
    nextLeaderboardRank = targetRank
    nextLeaderboardKillsNeeded = killsNeeded

    if status == "Reached" then
        nextLeaderboardETA = "Reached"
        LeaderboardETALabel.Text = "ETA to Top 1: Reached"
    elseif status == "Waiting for leaderboard" then
        nextLeaderboardETA = "Calculating..."
        LeaderboardETALabel.Text = "ETA to Top 15: Waiting for leaderboard"
    elseif targetRank and cutoff then
        nextLeaderboardETA = FormatETA(killsNeeded, killsPerHour)
        LeaderboardETALabel.Text = "ETA to Top " .. tostring(targetRank) .. ": " .. nextLeaderboardETA
    else
        nextLeaderboardETA = "Calculating..."
