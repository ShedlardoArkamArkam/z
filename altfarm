local function EnsureAltAnimation(character, humanoid)
    if AltAnimationTrack and AltAnimationCharacter == character then
        return AltAnimationTrack
    end
    StopAltAnimation()
    if not character or not humanoid or not humanoid.Parent then
        return nil
    end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        -- A local Animator permits local playback if this character has none.
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    local animationObject = Instance.new("Animation")
    animationObject.Name = "AltSemiInvisibility"
    animationObject.AnimationId = ALT_ANIMATION_ID
    local ok, track = pcall(function()
        return animator:LoadAnimation(animationObject)
    end)
    if not ok or not track then
        animationObject:Destroy()
        return nil
    end
    track.Priority = Enum.AnimationPriority.Action4
    track.Looped = true
    local playOk = pcall(function()
        track:Play(0, 1, 1)
    end)
    if not playOk then
        pcall(function() track:Destroy() end)
        animationObject:Destroy()
        return nil
    end
    AltAnimationTrack = track
    AltAnimationObject = animationObject
    AltAnimationCharacter = character
    AltAnimationLengthWarned = false
    return track
end
-- While Alt is selected, stop every other playing animation track on the
-- character. This runs every rendered frame so newly started tracks are also
-- cleared, while leaving the Semi-Invisibility track untouched.
local function ClearOtherPlayingAnimations(character, keepTrack)
    if not character or not keepTrack then
        return
    end
    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("Animator") then
            local ok, tracks = pcall(function()
                return object:GetPlayingAnimationTracks()
            end)
            if ok and tracks then
                for _, otherTrack in ipairs(tracks) do
                    if otherTrack ~= keepTrack then
                        pcall(function()
                            otherTrack:Stop(0)
                        end)
                    end
                end
            end
        end
    end
end
local function UpdateAltAnimation(character, humanoid)
    local track = EnsureAltAnimation(character, humanoid)
    if not track then
        return
    end
    if not track.IsPlaying then
        pcall(function()
            track:Play(0, 1, 1)
        end)
    end
    -- Keep the requested animation playing and pinned at 11.2s every rendered frame.
    local length = track.Length
    if length > 0 then
        if length >= ALT_ANIMATION_TIME_POSITION then
            pcall(function()
                track.TimePosition = ALT_ANIMATION_TIME_POSITION
            end)
        elseif not AltAnimationLengthWarned then
            AltAnimationLengthWarned = true
            warn(string.format(
                "Alt animation length is %.2fs, shorter than requested position %.2fs; it cannot be pinned at that position.",
                length,
                ALT_ANIMATION_TIME_POSITION
            ))
        end
    end
    -- Only called by the Alt-mode render-step branch, so Main's animations
    -- are not touched. Re-enforcing this every frame removes other animations
    -- that the default Animate script or another local script tries to play.
    ClearOtherPlayingAnimations(character, track)
end
-- Bind at the end of the render step so shift-lock / default character rotation
-- is overridden while Alt is selected. The Alt animation is also pinned every frame.
RunService:BindToRenderStep(
    AltSpinBindingName,
    Enum.RenderPriority.Last.Value,
    function(deltaTime)
        if not Running then
            return
        end
        if Mode ~= "Alt" then
            RestoreAltAutoRotate()
            StopAltAnimation()
            return
        end
        local character = Player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if humanoid then
            if not AltAutoRotateStates[humanoid] then
                AltAutoRotateStates[humanoid] = {
                    autoRotate = humanoid.AutoRotate
                }
            end
            humanoid.AutoRotate = false
            UpdateAltAnimation(character, humanoid)
        else
            StopAltAnimation()
        end
        if root and root:IsA("BasePart") then
            AltSpinAngle = (AltSpinAngle + deltaTime * ALT_SPIN_RADIANS_PER_SECOND) % (math.pi * 2)
            local position = root.Position
            root.CFrame = CFrame.new(position) * CFrame.Angles(0, AltSpinAngle, 0)
        end
        -- Alt-only velocity suppression: clear linear and angular assembly
        -- velocity on every character BasePart every rendered frame.
        if character then
            for _, descendant in ipairs(character:GetDescendants()) do
                if descendant:IsA("BasePart") then
                    descendant.AssemblyLinearVelocity = Vector3.zero
                    descendant.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
    end
)
