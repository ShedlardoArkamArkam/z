        return
    end
    Running = false
    pcall(function()
        ExecutorEnvironment[ACTIVE_SCRIPT_FLAG] = nil
    end)
    CancelMainWebhookSchedule()

    -- STOP really stops the script: no persistence queue or auto-rejoin after this point.
    KeepScriptEnabled = false
    StoreExecutorFlag(KEEP_SCRIPT_FLAG, false)
    DisableAutoRejoin()
    if PersistenceTeleportConnection then
        pcall(function()
            PersistenceTeleportConnection:Disconnect()
        end)
        PersistenceTeleportConnection = nil
    end

    TargetTeleporting = false
    TargetLockedForSkill = nil
    TargetEngaged = false
    DisconnectAltDamageMonitor()
