    if type(SCRIPT_RAW_URL) ~= "string"
        or SCRIPT_RAW_URL == ""
        or SCRIPT_RAW_URL == "PASTE_RAW_PASTEBIN_URL_HERE"
        or not SCRIPT_RAW_URL:match("^https?://") then
        warn("Persistence is enabled, but SCRIPT_RAW_URL needs your raw hosted script URL.")
        return
