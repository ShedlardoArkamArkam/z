local function ScheduleAutoRejoinRetry(attemptGeneration, reason, usePublicOnNextAttempt)
    if not Running or not AutoRejoinEnabled or not AutoRejoinInProgress
        or attemptGeneration ~= AutoRejoinAttemptGeneration then
        return
    end

    if usePublicOnNextAttempt then
        AutoRejoinAlwaysPublic = true
        AutoRejoinFallbackUsed = true
    end
    if AutoRejoinRetryScheduled then
        return
    end

    AutoRejoinRetryScheduled = true
    AutoRejoinTeleportStarted = false
    -- Player.OnTeleport may have cleared this marker while a failed teleport was
    -- being initialized. Restore it while this copy is still running.
    StoreExecutorFlag(ACTIVE_SCRIPT_FLAG, true)
    warn("Auto Rejoin failed (" .. tostring(reason or "unknown reason")
        .. "); retrying in " .. tostring(AUTO_REJOIN_DELAY_SECONDS) .. " seconds.")

    task.delay(AUTO_REJOIN_DELAY_SECONDS, function()
        if not Running or not AutoRejoinEnabled or not AutoRejoinInProgress
            or attemptGeneration ~= AutoRejoinAttemptGeneration then
            AutoRejoinRetryScheduled = false
            return
        end

        AutoRejoinRetryScheduled = false
        StartAutoRejoinAttempt(attemptGeneration)
    end)
end

StartAutoRejoinAttempt = function(attemptGeneration)
    if not Running or not AutoRejoinEnabled or not AutoRejoinInProgress
        or attemptGeneration ~= AutoRejoinAttemptGeneration then
        return
    end

    AutoRejoinAttemptCount += 1
    local thisAttemptNumber = AutoRejoinAttemptCount
    AutoRejoinTeleportStarted = false

    local useSameServer = not AutoRejoinAlwaysPublic
        and #Players:GetPlayers() > 1
        and game.JobId ~= ""

    -- Once using a public-server attempt, keep subsequent retries public too.
    if not useSameServer then
        AutoRejoinAlwaysPublic = true
    end

    AutoRejoinPrimarySameServer = useSameServer
    AutoRejoinFallbackUsed = not useSameServer
    SendAutoRejoinWebhookNotice(
        "Rejoining",
        "Starting reconnect attempt " .. tostring(AutoRejoinAttemptCount) .. ".",
        AutoRejoinAttemptCount
    )

    local ok, err = pcall(function()
        if useSameServer then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, Player)
        else
            TeleportService:Teleport(game.PlaceId, Player)
        end
    end)

    if not ok then
        ScheduleAutoRejoinRetry(
            attemptGeneration,
            "teleport request error: " .. tostring(err),
            useSameServer
        )
        return
    end

    -- If teleport did not begin, treat this attempt as failed. If it did begin
    -- but no replacement AltFarm instance appeared, retry instead of hanging.
    task.delay(AUTO_REJOIN_REQUEST_TIMEOUT_SECONDS, function()
        if not Running or not AutoRejoinEnabled or not AutoRejoinInProgress
            or attemptGeneration ~= AutoRejoinAttemptGeneration
            or AutoRejoinAttemptCount ~= thisAttemptNumber
            or AutoRejoinRetryScheduled then
            return
        end

        if AutoRejoinTeleportStarted and ExecutorEnvironment[ACTIVE_SCRIPT_FLAG] == true then
            -- The queued script has started in the replacement session.
            return
        end

        ScheduleAutoRejoinRetry(
            attemptGeneration,
            "no replacement session detected within "
                .. tostring(AUTO_REJOIN_REQUEST_TIMEOUT_SECONDS) .. " seconds",
            useSameServer
        )
    end)
end

FallbackToPublicServer = function(attemptGeneration)
    ScheduleAutoRejoinRetry(
        attemptGeneration,
        "same-server reconnect failed",
        true
    )
end

AttemptAutoRejoin = function()
    if not Running or not AutoRejoinEnabled or AutoRejoinInProgress then
        return
    end

    AutoRejoinInProgress = true
    AutoRejoinFallbackUsed = false
    AutoRejoinPrimarySameServer = false
    AutoRejoinTeleportStarted = false
    AutoRejoinRetryScheduled = false
    AutoRejoinAlwaysPublic = false
    AutoRejoinAttemptCount = 0
    AutoRejoinAttemptGeneration += 1
    local attemptGeneration = AutoRejoinAttemptGeneration

    ForcePersistenceOnForRejoin()
    SendAutoRejoinWebhookNotice(
        "Kick detected",
        "Roblox's disconnected prompt was detected. The first reconnect attempt will start in "
            .. tostring(AUTO_REJOIN_DELAY_SECONDS) .. " seconds.",
        0
    )
    print("AltFarm: kick detected; auto-rejoin starts in "
        .. tostring(AUTO_REJOIN_DELAY_SECONDS) .. " seconds.")

    -- Give a temporary internet outage time to recover before the first request.
    task.delay(AUTO_REJOIN_DELAY_SECONDS, function()
        if not Running or not AutoRejoinEnabled or not AutoRejoinInProgress
            or attemptGeneration ~= AutoRejoinAttemptGeneration then
            return
        end
        StartAutoRejoinAttempt(attemptGeneration)
    end)
end

