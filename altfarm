-- Randomize the Void-stage position across the FULL width and depth of the platform.
-- Keep a small edge margin so the character does not spawn half over an edge.
-- Before selecting a spot, avoid every other living player's character root:
-- first try positions at least 25 studs away; if crowded, try 45-stud clearance.
local StagingRandom = Random.new()
local StagingPositionCharacter = nil
local CurrentStagingPosition = nil
-- In Alt mode, stage a character only once per character life. Nearby players
-- do not cause an already-staged Alt to be moved to a different location.
local AltStageTeleportedCharacter = nil
local VOID_STAGE_EDGE_MARGIN = 5
local VOID_STAGE_MIN_PLAYER_DISTANCE = 25
local VOID_STAGE_FALLBACK_PLAYER_DISTANCE = 45
local VOID_STAGE_RANDOM_ATTEMPTS = 80
local function GetOtherLivingPlayerRoots()
    local roots = {}
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= Player then
            local character = otherPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
                table.insert(roots, root)
            end
        end
    end
    return roots
end
local function GetMinimumPlayerDistance(position, playerRoots)
    local minimumDistance = math.huge
    for _, root in ipairs(playerRoots) do
        if root.Parent then
            local distance = (root.Position - position).Magnitude
            if distance < minimumDistance then
                minimumDistance = distance
            end
        end
    end
    return minimumDistance
end
local function IsSafeVoidPosition(position, playerRoots, minimumDistance)
    return GetMinimumPlayerDistance(position, playerRoots) >= minimumDistance
end
local function MakeRandomVoidPosition()
    local halfX = math.max(0, VOID_PLATFORM_SIZE.X / 2 - VOID_STAGE_EDGE_MARGIN)
    local halfZ = math.max(0, VOID_PLATFORM_SIZE.Z / 2 - VOID_STAGE_EDGE_MARGIN)
    local x = VOID_STAGE_POSITION.X + StagingRandom:NextNumber(-halfX, halfX)
    local z = VOID_STAGE_POSITION.Z + StagingRandom:NextNumber(-halfZ, halfZ)
    local y = VOID_STAGE_POSITION.Y + VOID_PLATFORM_SIZE.Y / 2 + 3
    return Vector3.new(x, y, z)
end
local function ChooseSafeVoidPosition()
    local playerRoots = GetOtherLivingPlayerRoots()
    local bestPosition = nil
    local bestDistance = -1
    -- First pass: rerandomize until the landing point is clear by 25 studs.
    for _ = 1, VOID_STAGE_RANDOM_ATTEMPTS do
        local candidate = MakeRandomVoidPosition()
        local distance = GetMinimumPlayerDistance(candidate, playerRoots)
        if distance >= VOID_STAGE_MIN_PLAYER_DISTANCE then
            return candidate
        end
        if distance > bestDistance then
            bestDistance = distance
            bestPosition = candidate
        end
    end
    -- If the initial random samples were crowded, try for 45-stud clearance.
    for _ = 1, VOID_STAGE_RANDOM_ATTEMPTS do
        local candidate = MakeRandomVoidPosition()
        local distance = GetMinimumPlayerDistance(candidate, playerRoots)
        if distance >= VOID_STAGE_FALLBACK_PLAYER_DISTANCE then
            return candidate
        end
        if distance > bestDistance then
            bestDistance = distance
            bestPosition = candidate
        end
    end
    -- In an unusually crowded server, do not teleport to a point that is still
    -- within 25 studs of another living player. Return nil and retry next pass.
    if bestPosition and bestDistance >= VOID_STAGE_MIN_PLAYER_DISTANCE then
        return bestPosition
    end
    return nil
end
local function RefreshStagingPositionForCharacter(character)
    if not character then
