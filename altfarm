    TrackedTargets[targetPlayer] = true
    table.insert(Connections, targetPlayer.CharacterAdded:Connect(function(character)
        TrackTargetCharacter(targetPlayer, character, false)
    end))
    if targetPlayer.Character then
        TrackTargetCharacter(targetPlayer, targetPlayer.Character, true)
    end
end
