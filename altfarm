local function QueueCurrentScriptForTeleport()
    -- Auto Rejoin also needs to carry the script and its user configuration back
    -- into the next session. Keep Script alone can enable the same persistence.
    if not Running or not (KeepScriptEnabled or AutoRejoinEnabled) then
        return
