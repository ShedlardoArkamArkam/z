        or text:match("([%d,]+)%s+[Mm][Oo][Rr][Ee]%s+[Kk][Ii][Ll][Ll][Ss]")
    if numberText then
        -- Convert values such as "1,500" into 1500 for reliable numeric formatting.
        local numericValue = tonumber((numberText:gsub(",", "")))
        if numericValue then
            local digits = tostring(math.floor(numericValue))
            local formatted = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
            KillsNeededLabel.Text = "Kills needed for rank: " .. formatted
