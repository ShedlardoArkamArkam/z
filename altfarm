local function RunMainCycle()
    if not Running or Mode ~= "Main" then
        return false
    end
    -- Wait for a target to have been alive >= TARGET_ALIVE_SECONDS seconds, teleport behind them, wait 0.2s, press 2.
    if not TeleportThenTapKey(Enum.KeyCode.Two) then
        return false
    end
    if not WaitForMain(2) then
        return false
    end
    -- Wait for a target to have been alive >= TARGET_ALIVE_SECONDS seconds, teleport behind them, wait 0.2s, press 1.
    if not TeleportThenTapKey(Enum.KeyCode.One) then
        return false
    end
    if not WaitForMain(2.2) then
        return false
    end
    -- Pause target teleporting before entering the void.
    InVoidPhase = true
    TargetTeleporting = false
    TargetEngaged = false
    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if character and humanoid and humanoid.RigType == Enum.HumanoidRigType.R6 then
        pcall(function()
            character:PivotTo(character:GetPivot() + Vector3.new(0, -500, 0))
        end)
        -- Try both death mechanisms repeatedly for the configured duration.
        -- ChangeState(Dead) is the important addition; Health is also set to 0
        -- in case the experience's local character scripts rely on that path.
        local deadState = Enum.HumanoidStateType.Dead
        pcall(function()
            humanoid:SetStateEnabled(deadState, true)
        end)
        local deathDeadline = os.clock() + MAIN_VOID_HEALTH_ZERO_DURATION
        while Running
            and Mode == "Main"
            and Player.Character == character
            and humanoid.Parent
            and os.clock() < deathDeadline do
            pcall(function()
                humanoid:SetStateEnabled(deadState, true)
                humanoid:ChangeState(deadState)
                humanoid.Health = 0
            end)
            RunService.Heartbeat:Wait()
        end
    end
    -- Wait 5.7 seconds before the next cycle; a mode switch interrupts this wait.
    local completed = WaitForMain(5.7)
    InVoidPhase = false
    -- The following target is not acquired until the next scheduled skill press.
    TargetTeleporting = false
    TargetLockedForSkill = nil
    TargetEngaged = false
    return completed
end
