-- Interruptible wait
local function Wait(seconds)
    local finish = os.clock() + seconds
    while Running do
        local remaining = finish - os.clock()
        if remaining <= 0 then
            break
        end
        task.wait(math.min(0.03, remaining))
    end
    return Running
end
-- Wait only while Main mode is selected. Mode changes interrupt the current combat cycle.
local function WaitForMain(seconds)
    local finish = os.clock() + seconds
    while Running and Mode == "Main" do
        local remaining = finish - os.clock()
        if remaining <= 0 then
            break
        end
        task.wait(math.min(0.03, remaining))
    end
    return Running and Mode == "Main"
end
