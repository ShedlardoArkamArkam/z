-- Watch this character's health. A decrease while Alt mode is selected triggers
-- a reset; a zero delay sets Health to zero directly in the health-change callback.
local function MonitorAltDamage(character)
    AltDamageMonitorGeneration += 1
    local monitorGeneration = AltDamageMonitorGeneration
    if AltDamageConnection then
        pcall(function()
            AltDamageConnection:Disconnect()
        end)
        AltDamageConnection = nil
    end
    AltDamageCharacter = character
    CancelPendingAltDamageReset()
    if not character then
        return
    end
    task.spawn(function()
        local humanoid = character:FindFirstChildOfClass("Humanoid")
            or character:WaitForChild("Humanoid", 10)
        if not Running
            or monitorGeneration ~= AltDamageMonitorGeneration
            or AltDamageCharacter ~= character
            or Player.Character ~= character
            or not humanoid then
            return
        end
        local previousHealth = humanoid.Health
        local connection = humanoid.HealthChanged:Connect(function(newHealth)
            local tookDamage = newHealth < previousHealth
            previousHealth = newHealth
            if not tookDamage
                or not ALT_RESET_ON_DAMAGE
                or not Running
                or Mode ~= "Alt"
                or Player.Character ~= character
                or humanoid.Health <= 0
                or AltDamageResetPending then
                return
            end
            AltDamageResetPending = true
            AltDamageResetToken += 1
            local resetToken = AltDamageResetToken
            local function ResetIfStillValid()
                if resetToken == AltDamageResetToken
                    and Running
                    and ALT_RESET_ON_DAMAGE
                    and Mode == "Alt"
                    and Player.Character == character
                    and humanoid.Parent
                    and humanoid.Health > 0 then
                    -- Client-side reset request. The server may override client health.
                    pcall(function()
                        humanoid.Health = 0
                    end)
                end
                if resetToken == AltDamageResetToken then
                    AltDamageResetPending = false
                end
            end
            local delaySeconds = math.max(0, tonumber(ALT_DAMAGE_RESET_DELAY) or 0)
            if delaySeconds <= 0 then
                ResetIfStillValid()
            else
                task.delay(delaySeconds, ResetIfStillValid)
            end
        end)
        if Running
            and monitorGeneration == AltDamageMonitorGeneration
            and AltDamageCharacter == character then
            AltDamageConnection = connection
        else
            connection:Disconnect()
        end
    end)
end
