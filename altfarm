-- If the compact launcher is executed again, detect changed global settings and
-- apply them live without starting a duplicate copy of the main script.
local function TargetListsMatch(a, b)
    if type(a) ~= "table" or #a ~= #b then
        return false
    end
    for index, name in ipairs(b) do
        if a[index] ~= name then
            return false
        end
    end
    return true
end

task.spawn(function()
    while Running do
        local candidate = ExecutorEnvironment[FARM_CONFIG_KEY]
        local envWebhook = ExecutorEnvironment.WEBHOOK_URL
        local envTargets = ExecutorEnvironment.TargetNames
        local plainWebhook = _G.WEBHOOK_URL
        local plainTargets = _G.TargetNames

        local function GlobalsDiffer(webhook, names)
            return type(webhook) == "string"
                and type(names) == "table"
                and (webhook ~= WEBHOOK_URL or not TargetListsMatch(names, TargetNames))
        end

        -- Prefer whichever global environment actually changed compared with
        -- the values currently in use. The compact launcher needs no extra code.
        if GlobalsDiffer(envWebhook, envTargets) then
            candidate = { WEBHOOK_URL = envWebhook, TargetNames = envTargets }
        elseif GlobalsDiffer(plainWebhook, plainTargets) then
            candidate = { WEBHOOK_URL = plainWebhook, TargetNames = plainTargets }
        end

        if type(candidate) == "table" and candidate ~= InjectedFarmConfig then
            local newNames = {}
            if type(candidate.TargetNames) == "table" then
                for _, targetName in ipairs(candidate.TargetNames) do
                    if type(targetName) == "string" and targetName ~= "" then
                        table.insert(newNames, targetName)
                    end
                end
            end
            if type(candidate.WEBHOOK_URL) == "string" and #newNames > 0 then
                WEBHOOK_URL = candidate.WEBHOOK_URL
                table.clear(TargetNames)
                for _, targetName in ipairs(newNames) do
                    table.insert(TargetNames, targetName)
                end
                InjectedFarmConfig = {
                    WEBHOOK_URL = WEBHOOK_URL,
                    TargetNames = table.clone(TargetNames),
                }
                ExecutorEnvironment[FARM_CONFIG_KEY] = InjectedFarmConfig
                pcall(function()
                    ExecutorEnvironment.WEBHOOK_URL = WEBHOOK_URL
                    ExecutorEnvironment.TargetNames = table.clone(TargetNames)
                    _G.WEBHOOK_URL = WEBHOOK_URL
                    _G.TargetNames = table.clone(TargetNames)
                end)
                print("AltFarm: applied updated launcher configuration.")
            else
                warn("AltFarm ignored an invalid launcher configuration update.")
            end
        end
        task.wait(0.5)
    end
end)

